diff --git a/src/common/jit_code_buffer.cpp b/src/common/jit_code_buffer.cpp
index e0d6213..c9af03d 100644
--- a/src/common/jit_code_buffer.cpp
+++ b/src/common/jit_code_buffer.cpp
@@ -37,9 +37,24 @@ bool JitCodeBuffer::Allocate(uint32_t size /* = 64 * 1024 * 1024 */, uint32_t fa
   m_total_size = size + far_code_size;
 
 #if defined(_WIN32)
+#if defined(WINAPI_FAMILY) && WINAPI_FAMILY == WINAPI_FAMILY_APP
+  // UWP (Xbox in developer mode): code pages come from the *FromApp calls, writable first and executable after
+  m_code_ptr = static_cast<uint8_t*>(
+    VirtualAllocFromApp(nullptr, m_total_size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+  if (!m_code_ptr)
+    return false;
+  ULONG uwp_old_protect = 0;
+  if (!VirtualProtectFromApp(m_code_ptr, m_total_size, PAGE_EXECUTE_READWRITE, &uwp_old_protect))
+  {
+    VirtualFree(m_code_ptr, 0, MEM_RELEASE);
+    m_code_ptr = nullptr;
+    return false;
+  }
+#else
   m_code_ptr = static_cast<uint8_t*>(VirtualAlloc(nullptr, m_total_size, MEM_COMMIT, PAGE_EXECUTE_READWRITE));
   if (!m_code_ptr)
     return false;
+#endif
 #elif defined(__PROSPERO__)
   static const char jit_anchor = 0;
   m_code_ptr = static_cast<uint8_t*>(ps5_exec_allocate(m_total_size, (uintptr_t)&jit_anchor));
