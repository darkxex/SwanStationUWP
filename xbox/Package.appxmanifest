<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <!-- Publisher must match the subject of the certificate the package is signed with (tools/deploy-xbox.ps1 makes one) -->
  <Identity Name="SwanStationXbox" Publisher="CN=SwanStationXbox" Version="1.6.0.0" ProcessorArchitecture="x64" />
  <mp:PhoneIdentity PhoneProductId="6b0c2d3e-52f4-4c8e-9f6a-0d4c3a1e7b22" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>SwanStation Xbox</DisplayName>
    <PublisherDisplayName>SwanStationXbox</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows.Xbox: the Xbox Series X|S in developer mode (Windows.Universal also installs on a PC, to try the package) -->
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="SwanStationXbox.App">
      <uap:VisualElements
        DisplayName="SwanStation Xbox"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="A PlayStation 1 emulator (SwanStation) with a cover-flow shelf, Vulkan up to 16x resolution, RetroAchievements, cheats and save states."
        BackgroundColor="#101020">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#101020" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Games on a USB drive, outside the app's own folder -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <!-- The recompiler (JIT): code pages that are executable. Developer-mode and sideloaded packages only. -->
    <rescap:Capability Name="codeGeneration" />
    <rescap:Capability Name="expandedResources" />
  </Capabilities>
</Package>
